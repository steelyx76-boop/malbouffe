# URL du Webhook Discord (Paramètres du salon Discord -> Intégrations -> Webhooks -> Nouveau Webhook)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/VOTRE_WEBHOOK_ICI"

# Filtres de recherche
SEARCH_TEXT="numworks"
MIN_PRICE=20
MAX_PRICE=40

# Intervalle de vérification en secondes (10 à 20 secondes recommandé sans proxy)
CHECK_INTERVAL=15

# Mention Discord lors d'une alerte (@everyone, @here, ou laisser vide)
DISCORD_MENTION="@everyone"

# Proxy optionnel (utile pour un rafraîchissement ultra-rapide à 2-5 secondes)
# Format : http://username:password@ip:port ou socks5://ip:port
PROXY_URL=""
